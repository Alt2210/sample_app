<% provide :title, @user.name %>
<div class="row">
  <aside class="col-md-4">
    <section class="user_info">
      <h1>
        <%= gravatar_for @user %>
        <%= @user.name %>
      </h1>
    </section>
  </aside>
  <div class="col-md-8">
  <% if check_micropost %>
    <h3><%= t(".micropost", count: count_microposts) %></h3>
    <ol class="microposts">
      <%= render @microposts %>
    </ol>
    <%== @pagy.series_nav(:bootstrap) %>
  <% end %>
</div>
</div>
