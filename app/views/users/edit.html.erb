<% provide(:title, t(".title")) %>
<h1><%= t(".heading") %></h1>
<div class="row">
  <div class="col-md-6 col-md-offset-3">
    <%= render "form", button_text: t("activerecord.button.update") %>

    <div class="gravatar_edit">
      <%= gravatar_for @user %>
      <%= link_to Settings.links.gravatar_email, target: "_blank", rel: "noopener" do %>
        <%= t(".change") %>
      <%end %>
    </div>
  </div>
</div>
