<%= provide :title, t(".title") %>
<div class="center jumbotron">
  <h1><%= t(".title") %></h1>

  <h2>
    <%= t(".description") %>
    <%= link_to Settings.links.tutorial_link, target: "_blank" do%>
      <%= t(".tutorial_link") %>
    <%end%>
    <%= t(".sample_app") %>
  </h2>

  <%= link_to t(".signup"), signup_path, class: "btn btn-lg btn-primary" %>
</div>

<%= link_to image_tag("rails.png", alt: "Rails logo", width: "200"),
                      Settings.links.tutorial_link, target: "_blank" %>
