<li id="micropost-<%= micropost.id %>">
  <%= link_to gravatar_for(micropost.user, size: Settings.limit.digit_50), micropost.user %>
  <span class="user">
    <%= link_to micropost.user.name, micropost.user %>
  </span>
  <span class="content">
    <%= micropost.content %>
    <% if micropost.image.attached? %>
      <%= image_tag micropost.image.variant(:display) %>
    <% end %>
  </span>
  <span class="timestamp">
    <%= t(".post_time", time: time_ago_in_words(micropost.created_at)) %>
    <% if current_user? micropost.user %>
    <%= link_to t(".delete"), micropost, data: { "turbo-method": :delete, turbo_confirm: t(".turbo_confirm") } %>
    <% end %>
  </span>
</li>
