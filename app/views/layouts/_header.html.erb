<header class="navbar navbar-fixed-top navbar-inverse">
  <div class="container">
    <%= link_to t("layouts.header.logo"), "#", id: "logo" %>
    <nav>
      <ul class="nav navbar-nav navbar-right">
        <li><%= link_to t(".home"), root_path %></li>
        <li><%= link_to t(".help"), help_path %></li>
        <% if logged_in? %>
          <li><%= link_to t("layouts.header.users"), "#" %></li>
          <li class="dropdown" data-controller="dropdown">
            <%= link_to "#",
                        class: "dropdown-toggle",
                        data: {
                          dropdown_target: "toggle",
                          action: "click->dropdown#toggle keydown.esc->dropdown#close"
                        } do %>
              <%= t(".account") %>
              <b class="caret"></b>
            <% end %>
            <ul class="dropdown-menu" data-dropdown-target="menu">
              <li><%= link_to t(".profile"), current_user %></li>
              <li><%= link_to t(".setting"), "#" %></li>
              <li class="divider"></li>
              <li><%= link_to t(".log_out"), logout_path, data: { turbo_method: :delete } %></li>
            </ul>
          </li>
        <% else %>
          <li><%= link_to t(".log_in"), login_path %></li>
        <% end %>
        <li class="dropdown" data-controller="dropdown">
          <a href="#" class="dropdown-toggle" data-dropdown-target="toggle" data-action="click->dropdown#toggle keydown.esc->dropdown#close">
            <%= I18n.locale.upcase %>
            <b class="caret"></b>
          </a>
          <ul class="dropdown-menu dropdown-menu-right" data-dropdown-target="menu">
            <% Settings.available_locales.each do |locale| %>
              <li><%= link_to locale.upcase, url_for(locale: locale) %></li>
            <% end %>
          </ul>
        </li>
      </ul>
    </nav>
  </div>
</header>
